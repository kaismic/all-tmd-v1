
[
  {
    "run_name": "us-tmd-baseline",
    "train_dataset": "us-tmd",
    "labels": { "bus": 0, "car": 1, "train": 2 },
    "features": {
      "default_window_seconds": 10,
      "default_step_seconds": 5,
      "context_windows_seconds": [10],
      "sensors": {
        "accelerometer": ["mean", "standard_deviation", "range", "minimum"],
        "gyroscope": ["mean", "standard_deviation", "range", "minimum"],
        "magnetometer": ["standard_deviation", "range"],
        "pressure": ["standard_deviation", "range", "delta_from_window_start", "delta_from_session_baseline"]
      }
    },
    "training": {
      "random_seed": 42,
      "optuna_trials": 20,
      "model_families": ["random_forest", "xgboost", "mlp"],
      "calibration_fraction": {
        "bus": 0.8,
        "car": 0.4,
        "train": 0.4
      },
      "evaluation_strategy": "participant_nested_cv",
      "participant_inner_folds": 5,
      "weighting_strategy": "hierarchical",
      "collector_domain_weight": 1.0,
      "duration_balancing": "none",
      "selection_metric": "macro_f1",
      "bootstrap_iterations": 1000
    }
  },
